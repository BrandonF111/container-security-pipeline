# Legacy Research Analytics Tool - Internal Use Only
# WARNING: This Dockerfile contains known vulnerabilities for testing purposes
# This is being used to test creating a .trivyignore file

FROM ubuntu:18.04

LABEL maintainer="research-team@company.com"
LABEL description="Legacy data analytics tool for historical research data"

# Run as root (vulnerability)
USER root

# Install outdated packages with known CVEs
RUN apt-get update && apt-get install -y \
    python3.6 \
    python3-pip \
    curl \
    wget \
    git \
    libssl1.0.0 \
    openssh-server \
    netcat \
    && rm -rf /var/lib/apt/lists/*

# Install vulnerable Python packages
RUN pip3 install --no-cache-dir \
    Flask==1.1.1 \
    requests==2.20.0 \
    Jinja2==2.10.1 \
    PyYAML==5.1 \
    cryptography==2.6.1 \
    paramiko==2.4.2 \
    SQLAlchemy==1.3.0 \
    numpy==1.16.0

# Install vulnerable Node.js and packages
RUN curl -sL https://deb.nodesource.com/setup_10.x | bash - && \
    apt-get install -y nodejs

# Copy application with hardcoded secrets (vulnerability)
WORKDIR /app
COPY . /app

# Hardcoded credentials in environment (vulnerability)
ENV DB_PASSWORD="research_db_pass_2019" \
    API_KEY="sk-1234567890abcdef" \
    SECRET_KEY="hardcoded-secret-key-do-not-use" \
    DEBUG=True

# Create SSH keys (vulnerability - storing keys in image)
RUN ssh-keygen -t rsa -b 2048 -f /root/.ssh/id_rsa -N ""

# Expose multiple ports
EXPOSE 22 5000 8080 3000

# Set insecure permissions (vulnerability)
RUN chmod 777 /app && \
    chmod 777 /tmp

# Download and use unsigned binary (vulnerability)
RUN wget http://legacy-tools.internal.company.com/research-cli-v1.2.tar.gz && \
    tar -xzf research-cli-v1.2.tar.gz -C /usr/local/bin/ && \
    rm research-cli-v1.2.tar.gz

# Add example trivyignore entries for these vulnerabilities:
# CVE-2019-8331 (Bootstrap vulnerability in Flask)
# CVE-2020-26137 (urllib3 in requests)
# CVE-2019-11324 (urllib3)
# CVE-2019-20916 (pip vulnerability)
# CVE-2020-14343 (PyYAML)

# Run application as root (vulnerability)
CMD ["python3", "app.py"]
